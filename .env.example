# ---------------------------------------------------------------------------
# CINEMA KH — environment template
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL (used for OAuth redirects, sitemap, and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (REQUIRED — the app cannot sign in without these) -------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare Stream (required for real video) ----------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-stream-api-token
# Optional but recommended: signed playback tokens
CLOUDFLARE_STREAM_SIGNING_KEY=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
PLAYBACK_TOKEN_TTL_SECONDS=3600

# --- Ads --------------------------------------------------------------------
# Leave false until the ad provider has approved the site.
NEXT_PUBLIC_ADS_ENABLED=false
