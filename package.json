{
  "name": "cinema-kh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build && node scripts/verify-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build && node scripts/verify-build.mjs",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && node scripts/verify-build.mjs && opennextjs-cloudflare deploy",
    "cf:uploads": "opennextjs-cloudflare populateCache local",
    "seed:generate": "node --experimental-strip-types scripts/generate-seed.ts",
    "check:config": "node --experimental-strip-types scripts/check-config.ts",
    "admin:grant": "node --experimental-strip-types scripts/bootstrap-admin.ts",
    "db:push": "supabase db push",
    "build:next": "next build",
    "verify:build": "node scripts/verify-build.mjs",
    "icons": "python3 scripts/make-icons.py",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "check:launch:strict": "node scripts/check-launch-readiness.mjs --strict",
    "release": "npm run typecheck && npm run build && npm run check:launch"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-khmer": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "wrangler": "^4.161.0"
  }
}
